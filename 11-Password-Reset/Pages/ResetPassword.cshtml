@page
@model ResetPasswordModel
@{ ViewData["Title"] = "Reset password"; }
<h1>Choose a new password</h1>
@if (!string.IsNullOrEmpty(Model.Error)) { <div class="alert alert-danger">@Model.Error</div> }
<form method="post"><input type="hidden" name="token" value="@Model.Token" /><div class="mb-3"><label class="form-label">New password</label><input class="form-control" type="password" name="password" required minlength="8" /></div><button class="btn btn-primary">Update password</button></form>
